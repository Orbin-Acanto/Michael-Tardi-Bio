# Copy to .env.local for local development, and set the same keys in your
# Vercel project under Settings → Environment Variables.

# ── Required: where contact form submissions go ─────────────────────────
# The n8n webhook that receives leads, plus its basic-auth credentials.
# This site uses the 48 Wall Street credential pair on the shared n8n
# instance (primary-production-f807.up.railway.app). The real values are in
# .env.local, which is gitignored.
N8N_LEAD_WEBHOOK_URL=
N8N_USERNAME=
N8N_PASSWORD=

# ── Optional: reCAPTCHA v3 ──────────────────────────────────────────────
# Leave both blank and the form still works — the honeypot, minimum fill
# time, and IP rate limit stay active. Fill them in to add bot scoring.
# The VITE_ one is public (it ships in the browser bundle); the secret is not.
VITE_RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
